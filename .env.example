NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ads remain in mock mode unless ADS_BACKEND=supabase and a new project is connected.
# Do not copy keys from other projects. Never put a service role key in the frontend.
ADS_BACKEND=mock
ADS_SESSION_SALT=replace-with-local-random-salt

# Optional. If unset, GET /api/ads/report returns 404.
# ADS_REPORT_TOKEN=
